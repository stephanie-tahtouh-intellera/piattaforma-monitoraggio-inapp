# Valori dimostrativi: nessun segreto reale (NFR-007)
DEMO_DATASET=inapp            # inapp = portafoglio reale PN GDL; scenarios = 12 procedure dell'oracle (Vercel: scenarios)
DEMO_PASSWORD=Demo2026!
APP_REFERENCE_DATE=2026-10-01
SESSION_SECRET=cambiami-in-ambienti-non-locali
SMTP_HOST=localhost
SMTP_PORT=1025
APP_BASE_URL=http://localhost:3000

# Database (DEC-115): un solo Postgres (Vercel Postgres/Neon) per sviluppo locale, test e produzione.
# Creare lo store "Postgres" nel progetto Vercel (Storage -> Create -> Postgres): la variabile
# POSTGRES_URL viene impostata automaticamente nel progetto; copiarla anche qui per lo sviluppo locale.
POSTGRES_URL=postgres://<user>:<password>@<host>/<db>?sslmode=require

# Vercel (DEC-113): se BLOB_READ_WRITE_TOKEN è assente, l'app salva i documenti caricati su disco
# locale. Impostare solo nel progetto Vercel (Storage -> Create -> Blob), non in locale.
# BLOB_READ_WRITE_TOKEN=
